{
  "name": "discord-bot",
  "version": "1.0.0",
  "description": "Discord bot",
  "private": true,
  "main": "src/index.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "build:exe": "powershell -ExecutionPolicy Bypass -File ./scripts/build-exe.ps1",
    "db:up": "docker-compose up -d",
    "db:down": "docker-compose down",
    "db:reset": "docker-compose down -v && docker-compose up -d",
    "db:logs": "docker-compose logs -f postgres",
    "db:migrate": "docker run --rm --network discordbot_default -v ./migrations:/flyway/sql -v ./flyway.conf:/flyway/conf/flyway.conf flyway/flyway:10-alpine -url=jdbc:postgresql://discordbot-postgres:5432/discordbot -user=discordbot -password=discordbot_password migrate",
    "db:migrate:repair": "docker run --rm --network discordbot_default -v ./migrations:/flyway/sql -v ./flyway.conf:/flyway/conf/flyway.conf flyway/flyway:10-alpine -url=jdbc:postgresql://discordbot-postgres:5432/discordbot -user=discordbot -password=discordbot_password repair",
    "spotify:auth": "node scripts/spotify-auth.js"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@discordjs/opus": "^0.10.0",
    "@discordjs/voice": "^0.19.2",
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@snazzah/davey": "^0.1.11",
    "aws-sdk": "^2.1693.0",
    "discord.js": "^14.26.3",
    "dotenv": "^17.4.2",
    "ffmpeg-static": "^5.3.0",
    "libsodium-wrappers": "^0.8.3",
    "opusscript": "0.1.1",
    "pg": "^8.20.0",
    "play-dl": "^1.9.7",
    "sodium-native": "^5.1.0",
    "cors": "^2.8.6",
    "discord-oauth2": "^2.12.1",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.1.1",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  }
}
